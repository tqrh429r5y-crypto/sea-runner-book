{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sea-runner-book.vercel.app"
        }
      ],
      "destination": "https://searunner.it/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/boat",
      "destination": "/boat/index.html"
    },
    {
      "source": "/booking",
      "destination": "/booking/index.html"
    },
    {
      "source": "/booking/cinque-terre",
      "destination": "/booking/cinque-terre/index.html"
    },
    {
      "source": "/booking/golfo-dei-poeti",
      "destination": "/booking/golfo-dei-poeti/index.html"
    },
    {
      "source": "/booking/portofino",
      "destination": "/booking/portofino/index.html"
    },
    {
      "source": "/booking/half-day",
      "destination": "/booking/half-day/index.html"
    },
    {
      "source": "/booking/sunset",
      "destination": "/booking/sunset/index.html"
    },
    {
      "source": "/booking/tailored",
      "destination": "/booking/tailored/index.html"
    },
    {
      "source": "/it",
      "destination": "/it/index.html"
    },
    {
      "source": "/it/boat",
      "destination": "/it/boat/index.html"
    },
    {
      "source": "/it/booking",
      "destination": "/it/booking/index.html"
    },
    {
      "source": "/it/booking/cinque-terre",
      "destination": "/it/booking/cinque-terre/index.html"
    },
    {
      "source": "/it/booking/golfo-dei-poeti",
      "destination": "/it/booking/golfo-dei-poeti/index.html"
    },
    {
      "source": "/it/booking/portofino",
      "destination": "/it/booking/portofino/index.html"
    },
    {
      "source": "/it/booking/half-day",
      "destination": "/it/booking/half-day/index.html"
    },
    {
      "source": "/it/booking/sunset",
      "destination": "/it/booking/sunset/index.html"
    },
    {
      "source": "/it/booking/tailored",
      "destination": "/it/booking/tailored/index.html"
    },
    {
      "source": "/fr",
      "destination": "/fr/index.html"
    },
    {
      "source": "/fr/boat",
      "destination": "/fr/boat/index.html"
    },
    {
      "source": "/fr/booking",
      "destination": "/fr/booking/index.html"
    },
    {
      "source": "/fr/booking/cinque-terre",
      "destination": "/fr/booking/cinque-terre/index.html"
    },
    {
      "source": "/fr/booking/golfo-dei-poeti",
      "destination": "/fr/booking/golfo-dei-poeti/index.html"
    },
    {
      "source": "/fr/booking/portofino",
      "destination": "/fr/booking/portofino/index.html"
    },
    {
      "source": "/fr/booking/half-day",
      "destination": "/fr/booking/half-day/index.html"
    },
    {
      "source": "/fr/booking/sunset",
      "destination": "/fr/booking/sunset/index.html"
    },
    {
      "source": "/fr/booking/tailored",
      "destination": "/fr/booking/tailored/index.html"
    },
    {
      "source": "/booking/:path*",
      "destination": "/shell.html"
    },
    {
      "source": "/privacy",
      "destination": "/shell.html"
    },
    {
      "source": "/it/booking/:path*",
      "destination": "/shell.html"
    },
    {
      "source": "/it/privacy",
      "destination": "/shell.html"
    },
    {
      "source": "/fr/booking/:path*",
      "destination": "/shell.html"
    },
    {
      "source": "/fr/privacy",
      "destination": "/shell.html"
    }
  ],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
